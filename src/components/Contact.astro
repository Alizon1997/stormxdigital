---
import Container from "./Container.astro"
import Topic from "./Topic.astro";
import ContactForm from "./ContactForm";
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { TranslationType } from './types/services';

const currentLocale = Astro.currentLocale || 'it';

// Import translations
import enTranslations from '../../public/locales/en/translation.json';
import itTranslations from '../../public/locales/it/translation.json';

const translations: TranslationType = currentLocale === 'en' ? enTranslations : itTranslations;
---

<Container>
  <div class="relative flex flex-col items-center md:flex-row">
    <Topic   
      title={translations.contact.title}
      description={translations.contact.description} 
    />
  </div>

  <div class="relative flex flex-col lg:flex-row mb-24 bg-black rounded-[45px] p-4 lg:p-12">
    <div class="w-full lg:w-5/12 p-4 lg:p-8 border border-[#343434] rounded-3xl mb-4 lg:mb-0 lg:mr-4">
      <img src="../../team/c.webp" alt="Marcello" class="w-24 h-24 rounded-full mb-4" />
      <h2 class="text-xl lg:text-2xl font-semibold text-white mb-2">{translations.contact.meetingWithMarcello}</h2>
      <p class="text-base lg:text-base font-normal text-white mb-4 max-w-xs">
        {translations.contact.questions}
      </p>
      <button class="text-base lg:text-base text-white underline flex items-center justify-center">
        <a href="https://cal.com/marcello-di-pierro">
          <span class="mr-2 flex flex-row justify-start items-start text-left">
            <svg width="16px" height="16px" viewBox="0 0 1024 1024" class="icon" version="1.1" xmlns="http://www.w3.org/2000/svg" fill="#000000">
              <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
              <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
              <g id="SVGRepo_iconCarrier">
                <path d="M256 120.768L306.432 64 768 512l-461.568 448L256 903.232 659.072 512z" fill="#ffffff"></path>
              </g>
            </svg>
            &nbsp;{translations.contact.scheduleCall}
          </span>
        </a>
      </button>
    </div>
    
    <div class="w-full lg:w-7/12 p-4 lg:p-8 border border-[#343434] rounded-3xl">
      <h2 class="text-xl lg:text-2xl font-semibold text-white mb-4">{translations.contact.getFreeAnalysis}</h2>
      <ContactForm 
        client:load 
        translations={{
          name: translations.contact.name,
          contactNumber: translations.contact.contactNumber,
          email: translations.contact.email,
          companyBrand: translations.contact.companyBrand,
          message: translations.contact.message,
          contactUsNow: translations.contact.contactUsNow
        }}
      />
    </div>
  </div>
</Container>